<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-07-24 — Blocking stem prep full screen UI. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stem_prep_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000"
    android:gravity="center"
    android:clickable="true"
    android:padding="32dp">

    <TextView
        android:id="@+id/stem_prep_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparing Stems"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/stem_prep_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading…"
        android:textColor="#FFCCCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingBottom="32dp" />

    <ProgressBar
        android:id="@+id/stem_prep_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:max="100"
        android:progress="0"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/stem_prep_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="#FFAAAAAA"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>
